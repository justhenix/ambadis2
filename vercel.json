{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 build_web.py",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{server.py,rsa_benchmark.py,test_rsa_benchmark.py}"
    }
  },
  "rewrites": [
    { "source": "/api/:endpoint", "destination": "/api/index?endpoint=:endpoint" }
  ]
}
